{
  "openapi": "3.1.0",
  "info": { "title": "Simple ThirtyOne", "version": "1.0.0" },
  "paths": {
    "/items/{itemId}": {
      "get": {
        "parameters": [{ "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string" },
          "note": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } }
        }
      },
      "Tag": { "type": "object", "properties": { "tagCode": { "type": "string" } } }
    }
  }
}
